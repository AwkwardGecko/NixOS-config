#!/usr/bin/env bash

file="$1"
dir="$(dirname "$file")"
filename="$(basename "$file")"

# Collect all image files in the directory
# You can tweak the extensions to fit your needs
images=($(find "$dir" -maxdepth 1 -type f \( \
  -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' \
\) | sort))

# Launch nsxiv with all images and highlight the one you clicked
nsxiv -n "${images[@]}" -S "$filename"

