tmux new -s <nameOfSession>

tmux a #connect to last session

tmux a -t <nameOfSession> #connect to specific session

tmux ls # list sessions

# Prefix Key
CTRL + B (C-b)
#detach from session
D
# split window horizontally
SHIFT + 5
# split window vertically
SHIFT + '
# switch tab
Q + number
# move pane
hold CTRL + B, Arrows

